datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminConfig {
  id              String   @id @default("global")
  adminSecret     String   @default("skillprax_admin_2026")
  defaultProvider String   @default("groq")
  groqKey         String?
  groqApiKey      String?
  anthropicKey    String?
  geminiKey       String?
  openaiKey       String?
  openrouterKey   String?
  tavilyKey       String?
  tavilyApiKey    String?
  updatedAt       DateTime @updatedAt
}

model Workspace {
  id                  String      @id @default(cuid())
  userId              String      @default("default_user")
  title               String      @default("")
  skillName           String      @default("")
  domainCategory      String      @default("General Knowledge")
  pillar              String      @default("General Knowledge")
  category            String?     @default("General Knowledge")
  baselineKnowledge   String?     @default("")
  targetGoal          String      @default("Mastery")
  level               String      @default("Beginner")
  aiProvider          String      @default("groq")
  aiModel             String?
  status              String      @default("ACTIVE")
  estimatedTotalSteps Int         @default(5)
  currentStep         Int         @default(1)
  currentStepIndex    Int         @default(1)
  isGenerating        Boolean     @default(false)
  generationStartedAt DateTime?
  recommendedBooks    Json?
  steps               SkillStep[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model SkillStep {
  id                   String        @id @default(cuid())
  workspaceId          String
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stepIndex            Int
  title                String
  description          String        @default("")
  difficulty           String        @default("Beginner")
  whatYouWillLearn     String        @default("") @db.Text
  conceptualOverview   String?       @db.Text
  coreKeyTakeaways     Json          @default("[]")
  keyTakeaways         Json?         @default("[]")
  practicalApplication String        @default("") @db.Text
  objective            String?
  estimatedMinutes     Int           @default(45)
  questionCount        Int           @default(5)
  assessableUnits      Json          @default("[]")
  quizBlueprint        Json          @default("[]")
  resources            Json          @default("[]")
  status               String        @default("IN_PROGRESS")
  passingScore         Int           @default(80)
  attempts             QuizAttempt[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model QuizAttempt {
  id                  String    @id @default(cuid())
  stepId              String
  step                SkillStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userId              String    @default("default_user")
  score               Int       @default(0)
  scorePercent        Int       @default(0)
  correctCount        Int       @default(0)
  questionCount       Int       @default(0)
  passed              Boolean   @default(false)
  status              String    @default("in_progress")
  acuBreakdown        Json?     @default("[]")
  questions           Json?     @default("[]")
  answers             Json?     @default("[]")
  results             Json?     @default("[]")
  targetWeakAreasOnly Boolean   @default(false)
  userAnswers         Json?     @default("[]")
  diagnosticReport    String?
  weakConcepts        Json?
  remedialResources   Json?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
}

model AbandonmentLog {
  id                  String   @id @default(cuid())
  workspaceId         String
  trackTitle          String
  domain              String   @default("General Knowledge")
  completedStepsCount Int      @default(0)
  timeInvestedSeconds Int      @default(0)
  reason              String
  reasonDetail        String?
  createdAt           DateTime @default(now())
}
