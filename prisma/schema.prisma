datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminConfig {
  id              String   @id @default("global_config")
  adminSecret     String   @default("skillprax_admin_2026")
  openaiKey       String?
  anthropicKey    String?
  geminiKey       String?
  groqKey         String?
  defaultProvider String   @default("groq") // "groq" | "openai" | "anthropic" | "gemini"
  updatedAt       DateTime @updatedAt
}

model Workspace {
  id                  String       @id @default(cuid())
  userId              String       @default("default_user")
  title               String       // e.g. "Distributed Systems Architecture"
  category            String       // e.g. "Computer Science"
  baselineKnowledge   String       // User self-assessment
  targetGoal          String       // What the user wants to be able to build/achieve
  aiProvider          String       @default("groq") // "groq" | "openai" | "anthropic" | "gemini"
  aiModel             String?      // Specific model identifier override
  status              String       @default("ACTIVE") // "ACTIVE" | "MASTERED" | "ARCHIVED"
  estimatedTotalSteps Int          @default(5)
  currentStepIndex    Int          @default(1)
  recommendedBooks    Json?        // [{ "title": string, "author": string, "whyRead": string, "searchUrl": string }]
  steps               SkillStep[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model SkillStep {
  id               String        @id @default(cuid())
  workspaceId      String
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stepIndex        Int
  title            String
  difficulty       String        // "Beginner" | "Intermediate" | "Advanced" | "Mastery"
  objective        String        // Detailed scope of knowledge
  resources        Json          // [{ "title": string, "url": string, "type": "youtube"|"docs"|"reddit"|"article", "summary": string }]
  status           String        @default("IN_PROGRESS") // "IN_PROGRESS" | "READY_FOR_QUIZ" | "PASSED"
  passingScore     Int           @default(80) // AI dynamically calculates this threshold (70-90)
  questionCount    Int           @default(5)  // AI dynamically calculates question count (3-8)
  attempts         QuizAttempt[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model QuizAttempt {
  id                  String    @id @default(cuid())
  stepId              String
  step                SkillStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  score               Int       // Percentage 0-100
  passed              Boolean
  targetWeakAreasOnly Boolean   @default(false)
  userAnswers         Json      // [{ "questionId": string, "selectedOptionIndex": number }]
  diagnosticReport    String?   // AI analysis of flawed logic
  weakConcepts        Json?     // string[] of specific failed terms/concepts
  remedialResources   Json?     // [{ "title": string, "url": string, "type": string, "focusArea": string }]
  createdAt           DateTime  @default(now())
}
