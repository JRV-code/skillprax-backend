datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminConfig {
  id              String   @id @default("global")
  adminSecret     String   @default("skillprax_admin_2026")
  defaultProvider String   @default("groq")
  groqKey         String?
  groqApiKey      String?
  anthropicKey    String?
  geminiKey       String?
  openaiKey       String?
  openrouterKey   String?
  tavilyKey       String?
  tavilyApiKey    String?
  updatedAt       DateTime @updatedAt
}

model UserProfile {
  id                    String             @id @default(cuid())
  name                  String             @default("Explorer")
  email                 String?            @unique
  avatarUrl             String?
  googleId              String?
  isEmailVerified       Boolean            @default(false)
  gender                String?            @default("Prefer not to say")
  age                   Int?               @default(18)
  profession            String             @default("Class 12 Student")
  educationBoard        String             @default("GSEB")
  grade                 String             @default("Class 12")
  city                  String?            @default("Ahmedabad")
  state                 String?            @default("Gujarat")
  activeMonths          Int                @default(1)
  streakDays            Int                @default(1)
  freezeShields         Int                @default(0)
  targetHours           Int                @default(1)
  targetMinutes         Int                @default(50)
  alertNotification     String             @default("20:30")
  totalXp               Int                @default(0)
  targetDailyHours      Int                @default(1)
  targetDailyMinutes    Int                @default(50)
  reminderTime          String?            @default("20:30")
  remindersEnabled      Boolean            @default(true)
  dailyReminderEnabled  Boolean            @default(true)
  preferredReminderTime String             @default("19:00")
  timezone              String             @default("UTC")
  lastReminderSentAt    DateTime?
  lastPracticeDate      String?
  currentStreak         Int                @default(1)
  longestStreak         Int                @default(1)
  streakFreezes         Int                @default(0)
  emailKey              String?            @unique @map("email_key")
  googleSub             String?            @unique @map("google_sub")
  passwordHash          String?            @map("password_hash")
  lastLoginAt           DateTime?          @map("last_login_at")
  lastActiveDate        DateTime?
  preferredLanguage     String             @default("en") @map("preferred_language")
  ageCategory           String?            @default("Open") @map("age_category")
  dietaryPreference     String?            @default("Vegetarian") @map("dietary_preference")
  healthConditions      String?            @default("None") @map("health_conditions")
  onboardingCompleted   Boolean            @default(false) @map("onboarding_completed")
  level                 Int                @default(1)
  totalQuizzesTaken     Int                @default(0) @map("total_quizzes_taken")
  totalQuestionsAttempted Int              @default(0) @map("total_questions_attempted")
  totalQuestionsCorrect Int                @default(0) @map("total_questions_correct")
  avgQuizAccuracy       Float              @default(0) @map("avg_quiz_accuracy")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  workspaces            Workspace[]
  activityLogs          DailyActivityLog[]
  studySessions         StudySession[]
  badges                BadgeEarned[]
  reviews               Review[]
}

model SystemConfig {
  id           String   @id @default("global")
  groqApiKey   String?
  tavilyApiKey String?
  updatedAt    DateTime @updatedAt
}

model Profile {
  id                String         @id @default(cuid())
  name              String         @default("Explorer")
  email             String?
  gender            String?        @default("Prefer not to say")
  profession        String         @default("Student")
  educationBoard    String?        @default("GSEB")
  grade             String?        @default("Class 12")
  age               Int            @default(18)
  activeMonths      Int            @default(1)
  streakDays        Int            @default(1)
  freezeShields     Int            @default(0)
  targetHours       Int            @default(1)
  targetMinutes     Int            @default(50)
  alertNotification String         @default("20:30")
  totalXp           Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  workspaces        Workspace[]
  studySessions     StudySession[]
  badges            BadgeEarned[]
}

model StudySession {
  id            String       @id @default(uuid())
  profileId     String
  userProfile   UserProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profile       Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "StudySession_profile_fkey")
  minutes       Int          // Duration of study session
  sessionDate   DateTime     @default(now()) // Timestamp
  createdAt     DateTime     @default(now())

  @@index([profileId, sessionDate])
}

model BadgeEarned {
  id          String       @id @default(uuid())
  profileId   String
  userProfile UserProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profile     Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "BadgeEarned_profile_fkey")
  badgeKey    String       // e.g., "REACTION_VELOCITY", "ZERO_MISCONCEPTIONS", "MOMENTUM_14"
  tier        String       // "LEGENDARY", "EPIC", "RARE"
  unlockedAt  DateTime     @default(now())

  @@unique([profileId, badgeKey])
}

model Workspace {
  id                  String       @id @default(cuid())
  title               String
  subTitle            String       @default("")
  subGenre            String?
  domain              String?
  skillName           String?      @map("skill_name")
  domainCategory      String       @default("General Knowledge")
  targetGoal          String       @default("Full Mastery")
  level               String       @default("Beginner")
  desiredLevel        String?      @map("desired_level")
  dailyMinutes        Int?         @map("daily_minutes")
  experienceLevel     String?      @map("experience_level")
  stepCountReason     String?      @map("step_count_reason")
  currentStep         Int          @default(1)
  totalPlannedSteps   Int          @default(5)
  progress            Float        @default(0)
  aiEngine            String       @default("llama-3.3-70b-versatile")
  isGenerating        Boolean      @default(false)
  generationStartedAt DateTime?
  userProfileId       String?
  profileId           String?
  userProfile         UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  profile             Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "Workspace_profile_fkey")
  steps               SkillStep[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model SkillStep {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stepIndex       Int
  title           String
  description     String        @default("")
  status          String        @default("IN_PROGRESS")
  difficultyTier  String?       @default("FOUNDATIONS") @map("difficulty_tier")
  intro           Json?
  packStatus       String           @default("NOT_BUILT") @map("pack_status")
  packStage        String?          @map("pack_stage")
  packStartedAt    DateTime?        @map("pack_started_at")
  packError        String?          @map("pack_error")
  quizStatus       String           @default("NOT_BUILT") @map("quiz_status")
  quizStartedAt    DateTime?        @map("quiz_started_at")
  quizError        String?          @map("quiz_error")
  engagedAt        DateTime?        @map("engaged_at")
  approachBrief    Json?
  approachViewedAt DateTime?
  assessableUnits  Json             @default("[]")
  quizBlueprint    Json             @default("[]")
  questionCount    Int              @default(0)
  resources        Json             @default("[]")
  chapters         Chapter[]
  stepChapters     StepChapter[]
  stepTopics       StepTopic[]
  stepResources    Resource[]
  attempts         QuizAttempt[]
  attemptResults   AttemptResult[]
  stepTranslations StepTranslation[]
  contentDocument  ContentDocument?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model QuizAttempt {
  id            String    @id @default(cuid())
  stepId        String
  step          SkillStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  score         Int       @default(0)
  scorePercent  Int       @default(0)
  correctCount  Int       @default(0)
  questionCount Int       @default(0)
  totalCount    Int?
  attemptNumber Int       @default(1)
  passed        Boolean   @default(false)
  status        String    @default("in_progress")
  questions     Json?     @default("[]")
  answers       Json?     @default("[]")
  results       Json?     @default("[]")
  userAnswers   Json?     @default("[]")
  breakdown     Json?
  analysis      Json?
  analysisLanguage String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model AbandonmentLog {
  id                  String   @id @default(cuid())
  workspaceId         String
  trackTitle          String
  domain              String   @default("General Knowledge")
  completedStepsCount Int      @default(0)
  timeInvestedSeconds Int      @default(0)
  reason              String
  reasonDetail        String?
  createdAt           DateTime @default(now())
}

model DailyActivityLog {
  id            String      @id @default(cuid())
  userProfileId String
  date          String
  minutesSpent  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, date])
}

model AdminSecurity {
  id           String   @id @default("admin-master")
  passcodeHash String?
  salt         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id          String       @id @default(cuid())
  profileId   String?
  userName    String       @default("Skillprax Learner")
  avatarUrl   String?
  rating      Int          @default(5)
  reviewText  String
  skillTag    String?
  status      String       @default("published")
  isVerified  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userProfile UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailKey              String?   @unique @map("email_key")
  name                  String
  passwordHash          String?   @map("password_hash")
  avatarUrl             String?   @map("avatar_url")
  googleId              String?   @map("google_id")
  googleSub             String?   @unique @map("google_sub")
  isEmailVerified       Boolean   @default(true) @map("is_email_verified")
  lastLoginAt           DateTime? @map("last_login_at")
  gender                String?
  profession            String?
  city                  String?   @default("Ahmedabad")
  state                 String?   @default("Gujarat")
  dailyReminderEnabled  Boolean   @default(true) @map("daily_reminder_enabled")
  preferredReminderTime String    @default("19:00") @map("preferred_reminder_time")
  timezone              String    @default("UTC")
  lastReminderSentAt    DateTime? @map("last_reminder_sent_at")
  lastPracticeDate      String?   @map("last_practice_date")
  xp                    Int       @default(0)
  dietaryPreference     String?   @default("Vegetarian") @map("dietary_preference")
  medicalConditions     String?   @default("None") @map("medical_conditions")
  preferredLanguage     String?   @default("en") @map("preferred_language")
  totalSkillsCompleted  Int       @default(0) @map("total_skills_completed")
  ageCategory           String?   @default("Open") @map("age_category")
  healthConditions      String?   @default("None") @map("health_conditions")
  onboardingCompleted   Boolean   @default(false) @map("onboarding_completed")
  level                 Int       @default(1)
  totalQuizzesTaken     Int       @default(0) @map("total_quizzes_taken")
  totalQuestionsAttempted Int     @default(0) @map("total_questions_attempted")
  totalQuestionsCorrect Int       @default(0) @map("total_questions_correct")
  avgQuizAccuracy       Float     @default(0) @map("avg_quiz_accuracy")
  currentStreak         Int       @default(0) @map("current_streak")
  longestStreak         Int       @default(0) @map("longest_streak")
  lastActiveDate        DateTime? @map("last_active_date")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model UserSkill {
  id                 String              @id @default(uuid())
  userId             String?             @map("user_id")
  skillName          String              @map("skill_name")
  skillCategory      String              @map("skill_category")
  subGenre           String              @map("sub_genre")
  targetMasteryLevel String              @map("target_mastery_level")
  totalSteps         Int                 @default(5) @map("total_steps")
  currentStep        Int                 @default(1) @map("current_step")
  isCompleted        Boolean             @default(false) @map("is_completed")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("user_skills")
}

model BlueprintSkillStep {
  id                     String    @id @default(uuid())
  skillId                String    @map("skill_id")
  stepNumber             Int       @map("step_number")
  title                  String
  description            String    @default("")
  requiredPracticeDays   Int       @default(1) @map("required_practice_days")
  practiceDaysCompleted  Int       @default(0) @map("practice_days_completed")
  quizPassed             Boolean   @default(false) @map("quiz_passed")
  quizScore              Int?      @map("quiz_score")
  videoUrl               String    @default("") @map("video_url")
  videoId                String    @default("") @map("video_id")
  videoTitle             String?   @default("") @map("video_title")
  videoMiniGuide         String?   @default("") @map("video_mini_guide")
  docTitle               String?   @default("") @map("doc_title")
  docUrl                 String?   @default("") @map("doc_url")
  docDomain              String?   @default("") @map("doc_domain")
  docMiniGuide           String?   @default("") @map("doc_mini_guide")
  stepExplanation        String?   @default("") @map("step_explanation")
  documentationMarkdown  String    @default("") @map("documentation_markdown")
  documentationSourceUrl String?   @map("documentation_source_url")
  documentationQuadrants Json?     @default("{}") @map("documentation_quadrants")
  dailyDietPlan          Json?     @map("daily_diet_plan")
  topics                 Json?     @default("[]")
  difficultyTier         String?   @default("Foundations") @map("difficulty_tier")
  quizData               Json?     @default("[]") @map("quiz_data")
  isSourced              Boolean?  @default(false) @map("is_sourced")
  isUnlocked             Boolean   @default(false) @map("is_unlocked")
  isCompleted            Boolean   @default(false) @map("is_completed")

  @@unique([skillId, stepNumber])
  @@map("skill_steps")
}

model UserResourceHistory {
  id                 String   @id @default(uuid())
  userId             String?  @map("user_id")
  skillId            String?  @map("skill_id")
  stepNumber         Int?     @map("step_number")
  resourceType       String   @map("resource_type")
  resourceIdentifier String   @map("resource_identifier")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([userId, resourceIdentifier])
  @@unique([userId, resourceType, resourceIdentifier])
  @@map("user_resource_history")
}

model UserSportsProfile {
  id                   String            @id @default(uuid())
  userId               String?           @map("user_id")
  sportName            String            @map("sport_name")
  subGenre             String            @map("sub_genre")
  dietaryPreference    String            @default("Vegetarian") @map("dietary_preference")
  medicalConditions    String            @default("None") @map("medical_conditions")
  trainingGoal         String            @default("Agility & Reflexes") @map("training_goal")
  dailyPracticeMinutes Int               @default(45) @map("daily_practice_minutes")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  dailyPlans           SportsDailyPlan[]

  @@map("user_sports_profiles")
}

model SportsDailyPlan {
  id            String            @id @default(uuid())
  userSportsId  String            @map("user_sports_id")
  dayNumber     Int               @map("day_number")
  drills        Json
  nutritionPlan Json              @map("nutrition_plan")
  isCompleted   Boolean           @default(false) @map("is_completed")
  createdAt     DateTime          @default(now()) @map("created_at")
  sportsProfile UserSportsProfile @relation(fields: [userSportsId], references: [id], onDelete: Cascade)

  @@map("sports_daily_plans")
}

model UserMilestone {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  skillId        String    @map("skill_id")
  milestoneOrder Int       @map("milestone_order")
  title          String
  status         String    @default("locked")
  quizScore      Int?      @map("quiz_score")
  unlockedAt     DateTime? @map("unlocked_at")
  completedAt    DateTime? @map("completed_at")

  @@unique([userId, skillId, milestoneOrder])
  @@map("user_milestones")
}

model ContentDocument {
  id            String               @id @default(uuid())
  stepId        String?              @unique @map("step_id")
  resourceId    String?              @unique @map("resource_id")
  sourceType    String               @map("source_type")
  sourceUrl     String?              @map("source_url")
  sourceTitle   String?              @map("source_title")
  markdown      String?
  quadrants     Json?
  topicMap      Json                 @map("topic_map")
  approachBrief Json?                @map("approach_brief")
  createdAt     DateTime             @default(now()) @map("created_at")
  step          SkillStep?           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  translations  ContentTranslation[]

  @@map("content_documents")
}

model ContentTranslation {
  id                  String           @id @default(uuid())
  contentDocumentId   String?          @map("content_document_id")
  contentId           String?          @map("content_id")
  languageCode        String           @map("language_code")
  markdown            String?          @map("translated_markdown")
  quadrants           Json?            @map("translated_quadrants")
  topicMap            Json?            @map("topic_map")
  approachBrief       Json?            @map("approach_brief")
  createdAt           DateTime         @default(now()) @map("created_at")
  document            ContentDocument? @relation(fields: [contentDocumentId], references: [id], onDelete: Cascade)

  @@unique([contentDocumentId, languageCode])
  @@map("content_translations")
}

model UiTranslation {
  languageCode String   @id @map("language_code")
  strings      Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("ui_translations")
}

model ResourceHistory {
  id           String   @id @default(cuid())
  profileId    String   @map("profile_id")
  workspaceId  String   @map("workspace_id")
  stepIndex    Int      @map("step_index")
  resourceType String   @default("URL") @map("resource_type")
  identifier   String
  title        String?
  domain       String?
  fingerprint  String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, identifier])
  @@index([profileId])
  @@index([workspaceId, domain])
  @@index([workspaceId, fingerprint])
  @@map("resource_histories")
}

model Chapter {
  id            String     @id @default(cuid())
  stepId        String
  key           String                       // "c1".."c6"
  orderIndex    Int
  title         String
  covers        String                       // one sentence
  minutes       Int
  acuIds        Json                         // string[]
  preferredType String                       // VIDEO | DOCUMENT
  buildsOn      String?                      // short phrase from earlier steps
  newConcepts   Json                         // string[] (2-4 items new in this step)
  status        String     @default("PLANNED") // PLANNED | READY | NO_VERIFIED_LINK
  approachGuide Json?                        // section 8.4 shape
  anchors       Json?                        // [{id,text,origin}] — server-only
  step          SkillStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, key])
  @@map("chapters")
}

model Resource {
  id           String       @id @default(cuid())
  chapterId    String?      @map("chapter_id")
  chapter      StepChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  stepId       String?      @map("step_id")
  topicId      String?      @map("topic_id")
  type         String       @default("doc")
  title        String
  url          String
  domain       String?
  videoId      String?      @map("video_id")
  channelName  String?      @map("channel_name")
  videoType    String?      @map("video_type")
  canonicalKey String?      @map("canonical_key")
  snippet      String?
  embeddable   Boolean      @default(true)
  linkStatus   String       @default("UNCHECKED") @map("link_status")
  isPrimary    Boolean      @default(false) @map("is_primary")
  checkedAt    DateTime?    @map("checked_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  step         SkillStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  topic        StepTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model StepChapter {
  id        String      @id @default(cuid())
  stepId    String      @map("step_id")
  order     Int
  title     String
  summary   String      @default("")
  createdAt DateTime    @default(now()) @map("created_at")
  step      SkillStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  topics    StepTopic[]
  resources Resource[]

  @@map("step_chapters")
}

model StepTopic {
  id         String       @id @default(cuid())
  stepId     String       @map("step_id")
  chapterId  String?      @map("chapter_id")
  key        String
  order      Int
  title      String
  covers     String       @default("")
  minutes    Int          @default(5)
  acuIds     Json         @default("[]")
  guide      Json?
  facts      Json?        // INTERNAL, never in any API response
  status     String       @default("READY") // READY | NO_VERIFIED_LINK
  createdAt  DateTime     @default(now()) @map("created_at")
  step       SkillStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  chapter    StepChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  resources  Resource[]

  @@unique([stepId, key])
  @@map("step_topics")
}

model AttemptResult {
  id                   String    @id @default(cuid())
  stepId               String    @map("step_id")
  profileId            String?   @map("profile_id")
  kind                 String    @default("INITIAL") // INITIAL | TARGETED_RETEST | PERFECTION
  correctCount         Int       @default(0) @map("correct_count")
  totalCount           Int       @default(0) @map("total_count")
  percent              Int       @default(0)
  passed               Boolean   @default(false)
  topicBreakdown       Json      @default("[]") @map("topic_breakdown")
  analysis             Json?
  analysisTranslations Json?     @map("analysis_translations")
  createdAt            DateTime  @default(now()) @map("created_at")
  step                 SkillStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("attempt_results")
}

model StepTranslation {
  id           String    @id @default(cuid())
  stepId       String    @map("step_id")
  languageCode String    @map("language_code")
  payload      Json
  createdAt    DateTime  @default(now()) @map("created_at")
  step         SkillStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, languageCode])
  @@map("step_translations")
}

model QuizTranslation {
  id           String   @id @default(cuid())
  evaluationId String   @map("evaluation_id")
  languageCode String   @map("language_code")
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([evaluationId, languageCode])
  @@map("quiz_translations")
}

model VideoProgress {
  id         String   @id @default(cuid())
  profileId  String   @map("profile_id")
  resourceId String   @map("resource_id")
  seconds    Int      @default(0)
  duration   Int?
  watched    Boolean  @default(false)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([profileId, resourceId])
  @@map("video_progress")
}

model TranslationCache {
  id           String   @id @default(cuid())
  scope        String             // STEP_BOOK | QUIZ | UI
  scopeId      String             // stepId | evaluationId | 'ui'
  languageCode String
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([scope, scopeId, languageCode])
  @@map("translation_caches")
}

model SubgenreCache {
  id                  String   @id @default(cuid())
  normalizedSkillName String   @unique @map("normalized_skill_name")
  subgenres           Json
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("subgenre_caches")
}

model SportsPlayerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id")
  sport            String
  secondarySports  String[] @default([]) @map("secondary_sports")
  playingPosition  String   @map("playing_position")
  heightCm         Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg         Decimal? @map("weight_kg") @db.Decimal(5, 2)
  achievements     String?
  certificates     Json?    @default("[]")
  dateOfBirth      DateTime @default(dbgenerated("'2008-01-01'::date")) @map("date_of_birth") @db.Date
  isMinor          Boolean  @default(false) @map("is_minor")
  guardianName     String?  @map("guardian_name")
  guardianPhone    String?  @map("guardian_phone")
  guardianEmail    String?  @map("guardian_email")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, sport])
  @@map("sports_player_profiles")
}

model SportsClub {
  id               String   @id @default(uuid()) @db.Uuid
  clubName         String   @map("club_name")
  sportsOffered    String[] @map("sports_offered")
  city             String
  address          String
  latitude         Decimal  @db.Decimal(10, 7)
  longitude        Decimal  @db.Decimal(10, 7)
  timings          String
  competitionLevel String   @map("competition_level")
  monthlyFee       Decimal  @map("monthly_fee") @db.Decimal(10, 2)
  discountedFee    Decimal? @map("discounted_fee") @db.Decimal(10, 2)
  discountLabel    String?  @map("discount_label")
  facilities       String[] @default([])
  coachingStaff    Json?    @default("[]") @map("coaching_staff")
  websiteUrl       String?  @map("website_url")
  contactPhone     String?  @map("contact_phone")
  isVerified       Boolean  @default(false) @map("is_verified")
  verificationDocs Json?    @default("[]") @map("verification_docs")
  createdAt        DateTime @default(now()) @map("created_at")
  scoutingRequests SportsScoutingRequest[]
  ratings          SportsPlayerRating[]

  @@map("sports_clubs")
}

model SportsScoutingRequest {
  id               String      @id @default(uuid()) @db.Uuid
  clubId           String      @map("club_id") @db.Uuid
  playerId         String      @map("player_id")
  status           String      @default("pending")
  guardianApproved Boolean     @default(false) @map("guardian_approved")
  message          String?
  trialDate        DateTime?   @map("trial_date")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")
  club             SportsClub  @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, playerId])
  @@map("sports_scouting_requests")
}

model SportsPlayerRating {
  id             String     @id @default(uuid()) @db.Uuid
  playerId       String     @map("player_id")
  clubId         String     @map("club_id") @db.Uuid
  overallRating  Decimal?   @map("overall_rating") @db.Decimal(3, 1)
  technicalScore Int?       @map("technical_score")
  agilityScore   Int?       @map("agility_score")
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  club           SportsClub @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("sports_player_ratings")
}

model SportsShopProduct {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  sport      String
  category   String
  price      Decimal  @db.Decimal(10, 2)
  imageUrl   String   @map("image_url")
  sellerType String   @default("official") @map("seller_type")
  vendorName String?  @map("vendor_name")
  inStock    Boolean  @default(true) @map("in_stock")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("sports_shop_products")
}

model SportsTravelVan {
  id                 String   @id @default(uuid()) @db.Uuid
  registrationNumber String   @map("registration_number")
  driverName         String   @map("driver_name")
  driverPhone        String   @map("driver_phone")
  licenseLastFour    String   @map("license_last_four")
  isDriverVerified   Boolean  @default(false) @map("is_driver_verified")
  routeTitle         String   @map("route_title")
  stops              String[]
  totalSeats         Int      @default(14) @map("total_seats")
  availableSeats     Int      @default(14) @map("available_seats")
  monthlyFare        Decimal  @map("monthly_fare") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("sports_travel_vans")
}

model SportsEscrowTransaction {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id")
  transactionType    String    @map("transaction_type")
  referenceId        String    @map("reference_id")
  amount             Decimal   @db.Decimal(10, 2)
  razorpayPaymentId  String?   @map("razorpay_payment_id")
  escrowStatus       String    @default("held") @map("escrow_status")
  payoutReleasedAt   DateTime? @map("payout_released_at")
  refundedAt         DateTime? @map("refunded_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("sports_escrow_transactions")
}




