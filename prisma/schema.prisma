datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminConfig {
  id              String   @id @default("global")
  adminSecret     String   @default("skillprax_admin_2026")
  defaultProvider String   @default("groq")
  groqKey         String?
  groqApiKey      String?
  anthropicKey    String?
  geminiKey       String?
  openaiKey       String?
  openrouterKey   String?
  tavilyKey       String?
  tavilyApiKey    String?
  updatedAt       DateTime @updatedAt
}

model Workspace {
  id                  String      @id @default(cuid())
  title               String
  domainCategory      String      @default("General Knowledge")
  targetGoal          String      @default("Full Mastery")
  level               String      @default("beginner")
  isGenerating        Boolean     @default(false)
  generationStartedAt DateTime?
  steps               SkillStep[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model SkillStep {
  id                   String        @id @default(cuid())
  workspaceId          String
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stepIndex            Int
  title                String
  description          String        @default("")
  status               String        @default("IN_PROGRESS")
  assessableUnits      Json          @default("[]")
  quizBlueprint        Json          @default("[]")
  resources            Json          @default("[]")
  attempts             QuizAttempt[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model QuizAttempt {
  id              String    @id @default(cuid())
  stepId          String
  step            SkillStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  score           Int       @default(0)
  scorePercent    Int       @default(0)
  correctCount    Int       @default(0)
  questionCount   Int       @default(0)
  passed          Boolean   @default(false)
  status          String    @default("in_progress")
  questions       Json?     @default("[]")
  answers         Json?     @default("[]")
  results         Json?     @default("[]")
  userAnswers     Json?     @default("[]")
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model AbandonmentLog {
  id                  String   @id @default(cuid())
  workspaceId         String   // plain scalar, NOT a relation — survives workspace deletion
  trackTitle          String
  domain              String   @default("General Knowledge")
  completedStepsCount Int      @default(0)
  timeInvestedSeconds Int      @default(0)
  reason              String
  reasonDetail        String?
  createdAt           DateTime @default(now())
}

model UserProfile {
  id         String   @id @default("default-profile")
  name       String   @default("Explorer")
  age        Int?     @default(18)
  profession String   @default("Lifelong Learner")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AdminSecurity {
  id           String   @id @default("admin-master")
  passcodeHash String?
  salt         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

