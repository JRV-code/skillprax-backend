datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminConfig {
  id              String   @id @default("global")
  adminSecret     String   @default("skillprax_admin_2026")
  defaultProvider String   @default("groq")
  groqKey         String?
  groqApiKey      String?
  anthropicKey    String?
  geminiKey       String?
  openaiKey       String?
  openrouterKey   String?
  tavilyKey       String?
  tavilyApiKey    String?
  updatedAt       DateTime @updatedAt
}

model UserProfile {
  id                 String             @id @default(cuid())
  name               String             @default("Explorer")
  age                Int?               @default(18)
  profession         String             @default("Class 12 Student")
  educationBoard     String             @default("CBSE")
  grade              String             @default("Class 12")
  targetDailyHours   Int                @default(1)
  targetDailyMinutes Int                @default(0)
  reminderTime       String?            @default("20:00")
  currentStreak      Int                @default(0)
  longestStreak      Int                @default(0)
  streakFreezes      Int                @default(0)
  lastActiveDate     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  workspaces         Workspace[]
  activityLogs       DailyActivityLog[]
}

model Workspace {
  id                  String       @id @default(cuid())
  title               String
  domainCategory      String       @default("General Knowledge")
  targetGoal          String       @default("Full Mastery")
  level               String       @default("Beginner")
  currentStep         Int          @default(1)
  totalPlannedSteps   Int          @default(5)
  aiEngine            String       @default("llama-3.3-70b-versatile")
  isGenerating        Boolean      @default(false)
  generationStartedAt DateTime?
  userProfileId       String?
  userProfile         UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  steps               SkillStep[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model SkillStep {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stepIndex       Int
  title           String
  description     String        @default("")
  status          String        @default("IN_PROGRESS")
  assessableUnits Json          @default("[]")
  quizBlueprint   Json          @default("[]")
  questionCount   Int           @default(0)
  resources       Json          @default("[]")
  attempts        QuizAttempt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model QuizAttempt {
  id            String    @id @default(cuid())
  stepId        String
  step          SkillStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  score         Int       @default(0)
  scorePercent  Int       @default(0)
  correctCount  Int       @default(0)
  questionCount Int       @default(0)
  passed        Boolean   @default(false)
  status        String    @default("in_progress")
  questions     Json?     @default("[]")
  answers       Json?     @default("[]")
  results       Json?     @default("[]")
  userAnswers   Json?     @default("[]")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model AbandonmentLog {
  id                  String   @id @default(cuid())
  workspaceId         String
  trackTitle          String
  domain              String   @default("General Knowledge")
  completedStepsCount Int      @default(0)
  timeInvestedSeconds Int      @default(0)
  reason              String
  reasonDetail        String?
  createdAt           DateTime @default(now())
}

model DailyActivityLog {
  id            String      @id @default(cuid())
  userProfileId String
  date          String
  minutesSpent  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, date])
}

model AdminSecurity {
  id           String   @id @default("admin-master")
  passcodeHash String?
  salt         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

