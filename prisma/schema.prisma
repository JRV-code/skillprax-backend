datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminConfig {
  id              String   @id @default("global")
  adminSecret     String   @default("skillprax_admin_2026")
  defaultProvider String   @default("groq")
  groqKey         String?
  groqApiKey      String?
  anthropicKey    String?
  geminiKey       String?
  openaiKey       String?
  openrouterKey   String?
  tavilyKey       String?
  tavilyApiKey    String?
  updatedAt       DateTime @updatedAt
}

model UserProfile {
  id                    String             @id @default(cuid())
  name                  String             @default("Explorer")
  email                 String?            @unique
  avatarUrl             String?
  googleId              String?
  isEmailVerified       Boolean            @default(false)
  gender                String?            @default("Prefer not to say")
  age                   Int?               @default(18)
  profession            String             @default("Class 12 Student")
  educationBoard        String             @default("GSEB")
  grade                 String             @default("Class 12")
  activeMonths          Int                @default(1)
  streakDays            Int                @default(1)
  freezeShields         Int                @default(0)
  targetHours           Int                @default(1)
  targetMinutes         Int                @default(50)
  alertNotification     String             @default("20:30")
  totalXp               Int                @default(0)
  targetDailyHours      Int                @default(1)
  targetDailyMinutes    Int                @default(50)
  reminderTime          String?            @default("20:30")
  remindersEnabled      Boolean            @default(true)
  dailyReminderEnabled  Boolean            @default(true)
  preferredReminderTime String             @default("19:00")
  timezone              String             @default("UTC")
  lastReminderSentAt    DateTime?
  lastPracticeDate      String?
  currentStreak         Int                @default(1)
  longestStreak         Int                @default(1)
  streakFreezes         Int                @default(0)
  lastActiveDate        String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  workspaces            Workspace[]
  activityLogs          DailyActivityLog[]
  studySessions         StudySession[]
  badges                BadgeEarned[]
  reviews               Review[]
}

model SystemConfig {
  id           String   @id @default("global")
  groqApiKey   String?
  tavilyApiKey String?
  updatedAt    DateTime @updatedAt
}

model Profile {
  id                String         @id @default(cuid())
  name              String         @default("Explorer")
  email             String?
  gender            String?        @default("Prefer not to say")
  profession        String         @default("Student")
  educationBoard    String?        @default("GSEB")
  grade             String?        @default("Class 12")
  age               Int            @default(18)
  activeMonths      Int            @default(1)
  streakDays        Int            @default(1)
  freezeShields     Int            @default(0)
  targetHours       Int            @default(1)
  targetMinutes     Int            @default(50)
  alertNotification String         @default("20:30")
  totalXp           Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  workspaces        Workspace[]
  studySessions     StudySession[]
  badges            BadgeEarned[]
}

model StudySession {
  id            String       @id @default(uuid())
  profileId     String
  userProfile   UserProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profile       Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "StudySession_profile_fkey")
  minutes       Int          // Duration of study session
  sessionDate   DateTime     @default(now()) // Timestamp
  createdAt     DateTime     @default(now())

  @@index([profileId, sessionDate])
}

model BadgeEarned {
  id          String       @id @default(uuid())
  profileId   String
  userProfile UserProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profile     Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "BadgeEarned_profile_fkey")
  badgeKey    String       // e.g., "REACTION_VELOCITY", "ZERO_MISCONCEPTIONS", "MOMENTUM_14"
  tier        String       // "LEGENDARY", "EPIC", "RARE"
  unlockedAt  DateTime     @default(now())

  @@unique([profileId, badgeKey])
}

model Workspace {
  id                  String       @id @default(cuid())
  title               String
  subTitle            String       @default("")
  subGenre            String?
  domainCategory      String       @default("General Knowledge")
  targetGoal          String       @default("Full Mastery")
  level               String       @default("Beginner")
  currentStep         Int          @default(1)
  totalPlannedSteps   Int          @default(5)
  progress            Float        @default(0)
  aiEngine            String       @default("llama-3.3-70b-versatile")
  isGenerating        Boolean      @default(false)
  generationStartedAt DateTime?
  userProfileId       String?
  profileId           String?
  userProfile         UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  profile             Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "Workspace_profile_fkey")
  steps               SkillStep[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model SkillStep {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stepIndex       Int
  title           String
  description     String        @default("")
  status          String        @default("IN_PROGRESS")
  assessableUnits Json          @default("[]")
  quizBlueprint   Json          @default("[]")
  questionCount   Int           @default(0)
  resources       Json          @default("[]")
  attempts        QuizAttempt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model QuizAttempt {
  id            String    @id @default(cuid())
  stepId        String
  step          SkillStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  score         Int       @default(0)
  scorePercent  Int       @default(0)
  correctCount  Int       @default(0)
  questionCount Int       @default(0)
  passed        Boolean   @default(false)
  status        String    @default("in_progress")
  questions     Json?     @default("[]")
  answers       Json?     @default("[]")
  results       Json?     @default("[]")
  userAnswers   Json?     @default("[]")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model AbandonmentLog {
  id                  String   @id @default(cuid())
  workspaceId         String
  trackTitle          String
  domain              String   @default("General Knowledge")
  completedStepsCount Int      @default(0)
  timeInvestedSeconds Int      @default(0)
  reason              String
  reasonDetail        String?
  createdAt           DateTime @default(now())
}

model DailyActivityLog {
  id            String      @id @default(cuid())
  userProfileId String
  date          String
  minutesSpent  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, date])
}

model AdminSecurity {
  id           String   @id @default("admin-master")
  passcodeHash String?
  salt         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id          String       @id @default(cuid())
  profileId   String?
  userName    String       @default("Skillprax Learner")
  avatarUrl   String?
  rating      Int          @default(5)
  reviewText  String
  skillTag    String?
  status      String       @default("published")
  isVerified  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userProfile UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  avatarUrl             String?   @map("avatar_url")
  googleId              String?   @map("google_id")
  isEmailVerified       Boolean   @default(true) @map("is_email_verified")
  gender                String?
  profession            String?
  dailyReminderEnabled  Boolean   @default(true) @map("daily_reminder_enabled")
  preferredReminderTime String    @default("19:00") @map("preferred_reminder_time")
  timezone              String    @default("UTC")
  lastReminderSentAt    DateTime? @map("last_reminder_sent_at")
  lastPracticeDate      String?   @map("last_practice_date")
  xp                    Int       @default(0)
  dietaryPreference     String?   @default("Vegetarian") @map("dietary_preference")
  medicalConditions     String?   @default("None") @map("medical_conditions")
  preferredLanguage     String?   @default("en") @map("preferred_language")
  totalSkillsCompleted  Int       @default(0) @map("total_skills_completed")
  currentStreak         Int       @default(0) @map("current_streak")
  longestStreak         Int       @default(0) @map("longest_streak")
  lastActiveDate        DateTime? @map("last_active_date")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model UserSkill {
  id                 String              @id @default(uuid())
  userId             String?             @map("user_id")
  skillName          String              @map("skill_name")
  skillCategory      String              @map("skill_category")
  subGenre           String              @map("sub_genre")
  targetMasteryLevel String              @map("target_mastery_level")
  totalSteps         Int                 @default(5) @map("total_steps")
  currentStep        Int                 @default(1) @map("current_step")
  isCompleted        Boolean             @default(false) @map("is_completed")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  steps              BlueprintSkillStep[]

  @@map("user_skills")
}

model BlueprintSkillStep {
  id                     String    @id @default(uuid())
  skillId                String    @map("skill_id")
  stepNumber             Int       @map("step_number")
  title                  String
  description            String
  requiredPracticeDays   Int       @default(1) @map("required_practice_days")
  practiceDaysCompleted  Int       @default(0) @map("practice_days_completed")
  quizPassed             Boolean   @default(false) @map("quiz_passed")
  quizScore              Int?      @map("quiz_score")
  videoUrl               String    @map("video_url")
  videoId                String    @map("video_id")
  documentationMarkdown  String    @map("documentation_markdown")
  documentationSourceUrl String?   @map("documentation_source_url")
  documentationQuadrants Json      @map("documentation_quadrants")
  dailyDietPlan          Json?     @map("daily_diet_plan")
  isUnlocked             Boolean   @default(false) @map("is_unlocked")
  isCompleted            Boolean   @default(false) @map("is_completed")
  userSkill              UserSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, stepNumber])
  @@map("skill_steps")
}

model UserResourceHistory {
  id                 String   @id @default(uuid())
  userId             String?  @map("user_id")
  skillId            String?  @map("skill_id")
  stepNumber         Int?     @map("step_number")
  resourceType       String   @map("resource_type")
  resourceIdentifier String   @map("resource_identifier")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([userId, resourceType, resourceIdentifier])
  @@map("user_resource_history")
}

model UserSportsProfile {
  id                   String            @id @default(uuid())
  userId               String?           @map("user_id")
  sportName            String            @map("sport_name")
  subGenre             String            @map("sub_genre")
  dietaryPreference    String            @default("Vegetarian") @map("dietary_preference")
  medicalConditions    String            @default("None") @map("medical_conditions")
  trainingGoal         String            @default("Agility & Reflexes") @map("training_goal")
  dailyPracticeMinutes Int               @default(45) @map("daily_practice_minutes")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  dailyPlans           SportsDailyPlan[]

  @@map("user_sports_profiles")
}

model SportsDailyPlan {
  id            String            @id @default(uuid())
  userSportsId  String            @map("user_sports_id")
  dayNumber     Int               @map("day_number")
  drills        Json
  nutritionPlan Json              @map("nutrition_plan")
  isCompleted   Boolean           @default(false) @map("is_completed")
  createdAt     DateTime          @default(now()) @map("created_at")
  sportsProfile UserSportsProfile @relation(fields: [userSportsId], references: [id], onDelete: Cascade)

  @@map("sports_daily_plans")
}

model UserMilestone {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  skillId        String    @map("skill_id")
  milestoneOrder Int       @map("milestone_order")
  title          String
  status         String    @default("locked")
  quizScore      Int?      @map("quiz_score")
  unlockedAt     DateTime? @map("unlocked_at")
  completedAt    DateTime? @map("completed_at")

  @@unique([userId, skillId, milestoneOrder])
  @@map("user_milestones")
}

model ContentTranslation {
  id                  String   @id @default(uuid())
  contentId           String   @map("content_id")
  languageCode        String   @map("language_code")
  translatedQuadrants Json     @map("translated_quadrants")
  translatedMarkdown  String   @map("translated_markdown")
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([contentId, languageCode])
  @@map("content_translations")
}



