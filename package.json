{
  "name": "skillprax-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "clean:orphans": "node src/db/cleanOrphanedSteps.js",
    "build": "node src/db/cleanOrphanedSteps.js && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "postinstall": "node src/db/cleanOrphanedSteps.js && prisma generate",
    "render-build": "node src/db/cleanOrphanedSteps.js && npx prisma generate && npx prisma migrate deploy && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@google/genai": "^2.24.0",
    "@prisma/client": "^5.19.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "google-auth-library": "^11.2.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.5.12",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.19.1",
    "tsx": "^4.19.0"
  }
}
